90-67812345`35672to Bitwarden Secrets Manager (the recommended setup, see docs/push_all.md).
# With Bitwarden, create secrets with exactly these names instead of using this file.
# Otherwise: copy this file to .env and fill in what you use. .env is never committed.
# On a Linux server: chmod 600 .env  (only the user that runs the pushers can read it)
# Real environment variables take precedence over this file.

# --- Gmail (sends the report) ---
# Use an App Password, not the account password: Google Account -> Security ->
# 2-Step Verification (must be on) -> App passwords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Comma-separated. Default: push_all_config.json "email.to", else GMAIL_ADDRESS.
# REPORT_TO=

# --- Vinted ---
VINTED_PRO_TOKEN=

# --- eBay ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

# --- Amazon EU ---
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=

# --- Casa del Libro ---
CASADELLIBRO_API_URL=
CASADELLIBRO_API_KEY=

# --- Fnac ---
FNAC_API_URL=
FNAC_PARTNER_ID=
FNAC_SHOP_ID=
FNAC_KEY=

# --- AbeBooks / IberLibro ---
ABEBOOKS_USERNAME=
ABEBOOKS_API_KEY=

# --- booklooker.de (Germany) ---
BOOKLOOKER_API_KEY=

# --- El Corte Inglés ---
ELCORTEINGLES_API_URL=
ELCORTEINGLES_API_KEY=

# --- Carrefour ---
CARREFOUR_API_URL=
CARREFOUR_API_KEY=

# --- Worten (Portugal / Spain) ---
WORTEN_API_URL=
WORTEN_API_KEY=

# --- IBS.it (Italy) ---
IBS_API_URL=
IBS_API_KEY=

# --- Empik (Poland) ---
EMPIK_API_URL=
EMPIK_API_KEY=

# --- E.Leclerc (France) ---
LECLERC_API_URL=
LECLERC_API_KEY=

# --- Kaufland (kaufland.es) ---
KAUFLAND_CLIENT_KEY=
KAUFLAND_SECRET_KEY=

# --- bol.com (Netherlands / Belgium) ---
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# --- Cdiscount (Octopia Seller API) ---
OCTOPIA_CLIENT_ID=
OCTOPIA_CLIENT_SECRET=
OCTOPIA_SELLER_ID=

# --- Allegro (Poland; device-flow app + one-time `allegro_push.py auth`) ---
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# refresh_token from allegro_token.json, for servers (single-use: the token file is kept up to date)
ALLEGRO_REFRESH_TOKEN=

# --- AliExpress (Open Platform app + seller authorization) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# refresh_token from aliexpress_token.json (after `aliexpress_push.py token <code>`), for servers
ALIEXPRESS_REFRESH_TOKEN=

# --- Temu (self-developed app + access token from Seller Center) ---
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=

# --- TikTok Shop (Partner Center app + seller authorization) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# refresh_token from tiktok_token.json (after `tiktok_push.py token <code>`), for servers
TIKTOK_REFRESH_TOKEN=

# --- Galaxus (CH/DE): SFTP login from the Galaxus onboarding ---
GALAXUS_SFTP_USER=
GALAXUS_SFTP_PASSWORD=
# [ProviderName] in the feed file name StockPricingData_<provider>.csv (letters, digits, _ or -)
GALAXUS_PROVIDER=

# --- OTTO Market (Germany): self-app in OTTO Partner Connect (interfaces: products, availability) ---
OTTO_CLIENT_ID=
OTTO_CLIENT_SECRET=

# --- eMAG Marketplace (RO/BG/HU): API user; eMAG must whitelist the server's IP ---
EMAG_USERNAME=
EMAG_PASSWORD=

# --- Fruugo: product feed at a static URL that Fruugo downloads ---
# Public URL of the feed (give it to Fruugo's integration team). Images are published next to it (img/).
FRUUGO_FEED_URL=
# Either a local folder that your web server serves at that URL ...
FRUUGO_FEED_DIR=
# ... or your web host over SFTP (host key pinned: "ssh-ed25519 AAAA...").
FRUUGO_SFTP_HOST=
FRUUGO_SFTP_PORT=22
FRUUGO_SFTP_USER=
FRUUGO_SFTP_PASSWORD=
FRUUGO_SFTP_KEY_FILE=
FRUUGO_SFTP_DIR=
FRUUGO_SFTP_HOSTKEY=

# --- CDON (SE/DK/FI/NO): Merchant Center -> API ---
CDON_MERCHANT_ID=
CDON_API_TOKEN=
